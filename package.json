{
  "name": "sauce-demo",
  "version": "1.0.0",
  "description": "This project is an e2e test automation suite built with Cypress for the SauceDemo application (https://www.saucedemo.com/). Its main goal is to validate critical user flows covering key functionalities such as user authentication, product listing, cart management and checkout process.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:smoke": "npx cypress run --expose grepTags=@smoke,grepOmitFiltered=true",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/auth/**/*.cy.js' --expose grepTags=-@smoke,grepOmitFiltered=true",
    "cy:run:catalog": "cypress run --spec 'cypress/e2e/catalog/**/*.cy.js' --expose grepTags=-@bug,grepOmitFiltered=true",
    "cy:run:checkout": "cypress run --spec 'cypress/e2e/checkout/**/*.cy.js' --expose grepTags=-@smoke+-@bug,grepOmitFiltered=true",
    "cy:run:cart": "cypress run --spec 'cypress/e2e/cart/**/*.cy.js'",
    "cy:run:bug": "cypress run --expose grepTags=@bug,grepOmitFiltered=true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "e2e"
  ],
  "author": "Daniela Vescia",
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^6.0.3",
    "allure-cypress": "^3.10.2",
    "cypress": "^15.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "6.4.4",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6"
  }
}
